{
  "name": "dsh-ui-background",
  "version": "0.5.1",
  "description": "One-click DSH Web background switcher: gradient presets (aurora/sunset/emerald), local-image upload, Bing daily wallpaper (4K/UHD, region, daily auto-update), opacity/blur/fill controls, light streaks and particle effects.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "background",
    "wallpaper",
    "web-ui",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/it-kxw/dsh-ui-background.git"
  },
  "homepage": "https://github.com/it-kxw/dsh-ui-background#readme",
  "bugs": {
    "url": "https://github.com/it-kxw/dsh-ui-background/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json --emitDeclarationOnly && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:D:/tools/deepseek-harness/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "link:D:/tools/deepseek-harness/deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-client-locale": "link:D:/tools/deepseek-harness/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:D:/tools/deepseek-harness/deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-test-runtime": "link:D:/tools/deepseek-harness/deepseek-harness/packages/test-support/client-runtime",
    "@deepseek-ai/dsh-client-ui-layout": "link:D:/tools/deepseek-harness/deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-renderer": "link:D:/tools/deepseek-harness/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "link:D:/tools/deepseek-harness/deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:D:/tools/deepseek-harness/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:D:/tools/deepseek-harness/deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-home-paths": "link:D:/tools/deepseek-harness/deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-settings": "link:D:/tools/deepseek-harness/deepseek-harness/packages/settings/settings",
    "@deepseek-ai/schemastery": "link:D:/tools/deepseek-harness/deepseek-harness/vendor/schemastery",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}